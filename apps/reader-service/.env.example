# Example environment for racetag-reader-service
# Copy to .env and adjust values.

# Reader connection
# Optional: leave READER_IP unset to discover the reader on the local network.
READER_IP=192.168.1.130
CONTROL_PORT=50007
EVENT_PORT=50008

# Behavior flags
NO_COLOR=false
INTERACTIVE=false
RAW=false

# Optional: path inside container to init commands file
# If unset, defaults to 'init_commands' bundled in the image
INIT_COMMANDS_FILE=/app/src/init_commands

# Backend configuration
# Transport: http (default) or mock
BACKEND_TRANSPORT=http
# Backend URL only required when transport=http. Example:
BACKEND_URL=http://localhost:8000
# Optional token for Authorization: Bearer <token>  --> Token type changed to X-API-Key for now
# Optional token for X-API-Key: <token>
BACKEND_TOKEN=changeme

# Reader-side minimum seconds between two forwarded arrive events for the
# same tag. 0 = presence union only; the backend owns the lap cooldown.
MIN_LAP_INTERVAL_S=0

# Reader status heartbeat to {BACKEND_URL}/reader/status (0 disables)
HEARTBEAT_INTERVAL_S=2.0

# Discovery: search the network after this many failed connects, at most
# every DISCOVER_INTERVAL_S seconds. NO_DISCOVER=true disables the automatic runs.
DISCOVER_AFTER_FAILURES=6
DISCOVER_INTERVAL_S=60
NO_DISCOVER=false

# Re-push the host UTC clock to the connected reader every N seconds (0 disables)
CLOCK_RESYNC_INTERVAL_S=1800

# Logging: reader.log (2 MB x 5) is always written to RACETAG_LOG_DIR
# (default ~/.racetag/logs); RACETAG_FILE_LOG=0 disables it.
# RACETAG_LOG_DIR=/app/logs
# RACETAG_FILE_LOG=1
